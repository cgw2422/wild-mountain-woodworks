# ---------------------------------------------------------------------------
# Wild Mountain Woodworks — environment variables
# Copy to .env for local development. On Railway, set these as service variables.
# ---------------------------------------------------------------------------

# REQUIRED -------------------------------------------------------------------
# PostgreSQL connection string. On Railway use ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://user:password@localhost:5432/wildmountain"

# Public origin used for canonical URLs, sitemap, OpenGraph and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ADMIN SECURITY -------------------------------------------------------------
# Required in production: signs admin session cookies and encrypts two-factor
# secrets. Generate with:  openssl rand -base64 48
# Keep a copy in your password manager: changing it signs everyone out and
# invalidates enrolled authenticator apps. Never commit the real value.
# BETTER_AUTH_SECRET=""
# Optional: serve the admin on its own subdomain (see README → Security).
# ADMIN_URL="https://admin.example.com"
# Optional: admin session idle timeout and absolute lifetime (hours).
# ADMIN_SESSION_IDLE_HOURS="4"
# ADMIN_SESSION_MAX_HOURS="168"
# Only when behind Cloudflare AND the origin accepts only Cloudflare traffic.
# TRUST_CLOUDFLARE="true"

# IMAGE STORAGE --------------------------------------------------------------
# "r2" for Cloudflare R2 (production), "local" for local disk (development).
STORAGE_DRIVER="local"
# Local driver only: where files are written (default ./storage). On Railway,
# point this at a mounted Volume if you are not using R2.
# LOCAL_STORAGE_DIR="/data/storage"

# Cloudflare R2 (required when STORAGE_DRIVER=r2). NEVER expose these publicly.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="wild-mountain-media"
# Public base URL for the bucket (custom domain or r2.dev URL). Must be set at
# BUILD time too, so next/image can optimize images from it.
# R2_PUBLIC_URL="https://media.example.com"

# FIRST ADMIN (used by `npm run db:seed` only if no admin with this email exists)
# ADMIN_EMAIL="owner@example.com"
# ADMIN_PASSWORD="use-a-long-unique-password"
# ADMIN_NAME="Owner"

# Seed sample demonstration content into an empty catalog (default true).
# SEED_SAMPLE_CONTENT="true"

# EMAIL (optional) -------------------------------------------------------------
# Without a provider, submissions are still saved and visible in admin; emails
# are logged instead of sent. Providers: "resend" | "postmark".
# EMAIL_PROVIDER="resend"
# EMAIL_FROM="Wild Mountain Woodworks <hello@example.com>"
# RESEND_API_KEY=""
# POSTMARK_SERVER_TOKEN=""
# Fallback recipient for new-inquiry notifications (Settings → Notification email wins).
# ADMIN_NOTIFICATION_EMAIL=""

# FUTURE: STRIPE (NOT required — the site runs perfectly without these) ------
# E-commerce only activates when Settings → E-commerce is ON *and* both keys exist.
# STRIPE_SECRET_KEY=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# OPTIONAL -------------------------------------------------------------------
# LOG_LEVEL="info"
# DATABASE_POOL_SIZE="10"
