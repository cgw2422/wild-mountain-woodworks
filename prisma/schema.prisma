// Wild Mountain Woodworks — database schema
//
// Design notes
// - Money is stored as integer cents (USD) everywhere. Never floats.
// - Images are NEVER stored in the database. `Media` rows hold metadata and the
//   object-storage key/URL (Cloudflare R2 in production). Every public-facing
//   photograph is referenced through a foreign key to `Media`, which is what
//   powers "this image is used in N locations" and safe deletion.
// - Quotes and orders store immutable configuration SNAPSHOTS (JSON) so later
//   edits to products/options never rewrite what a customer requested.
// - Records that historical data depends on are archived, not deleted.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

/// OWNER: full control, including admin users, roles and security.
/// ADMIN: products, quotes, content, media and ordinary site management.
enum AdminRole {
  OWNER
  ADMIN
}

/// Admin accounts. Authentication (password hashing, sessions, two-factor)
/// is handled by Better Auth (src/lib/auth/auth.ts); these tables follow its
/// schema. There is no public sign-up: accounts are created by an owner in
/// Admin → Security or by the controlled bootstrap (seed / admin:create).
model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  emailVerified    Boolean   @default(true)
  image            String?
  role             AdminRole @default(ADMIN)
  active           Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relation names follow Better Auth's Prisma adapter convention
  // (lower-cased model name + "s"), which it uses for joins.
  adminsessions   AdminSession[]
  adminaccounts   AdminAccount[]
  admintwofactors AdminTwoFactor[]
  activities      ActivityLog[]
  notes           InternalNote[]
  statusEvents    StatusEvent[]
  mediaUploads    Media[]
  videoUploads    ProductVideo[]
  estimates       PriceEstimate[]
}

/// Server-side admin sessions (Better Auth). The cookie holds the token plus
/// an HMAC signature made with BETTER_AUTH_SECRET, so a database leak alone
/// can't be turned into a valid cookie. Revoking = deleting the row.
model AdminSession {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

/// Credential store (Better Auth "account"). `password` is a scrypt hash
/// (legacy bcrypt hashes are still verified and upgraded on next sign-in).
model AdminAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Short-lived verification values (e.g. the pending two-factor challenge).
model AdminVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// TOTP secret and backup codes, both encrypted with BETTER_AUTH_SECRET.
model AdminTwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
}

model ActivityLog {
  id         String     @id @default(cuid())
  type       String // e.g. product.published, quote.status_changed
  message    String
  entityType String?
  entityId   String?
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Media library (metadata only — binaries live in object storage)
// ---------------------------------------------------------------------------

model Media {
  id           String     @id @default(cuid())
  storageKey   String     @unique
  url          String
  filename     String
  originalName String
  mimeType     String
  size         Int // bytes
  width        Int
  height       Int
  alt          String     @default("")
  caption      String?
  // Focal point (0-100 %) used when an image is cropped for a design
  // location's aspect ratio. The original file is never altered.
  focalX       Int        @default(50)
  focalY       Int        @default(50)
  // Tiny base64 blur placeholder for progressive loading.
  blurDataUrl  String?
  isSample     Boolean    @default(false)
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  productImages    ProductImage[]
  portfolioImages  PortfolioImage[]
  categories       Category[]
  optionValues     OptionValue[]
  addOns           AddOn[]
  pageSections     PageSection[]    @relation("SectionImage")
  pageSectionItems SectionItem[]
  pagesOg          Page[]           @relation("PageOgImage")
  settingsOg       SiteSetting[]    @relation("SettingsOgImage")
  videoPosters     ProductVideo[]   @relation("VideoPoster")

  @@index([createdAt])
  @@index([filename])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  imageId        String?
  image          Media?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  // Optional destination override. e.g. a "Custom Furniture" tile on the
  // homepage that links to /custom-furniture instead of a product listing.
  linkUrl        String?
  seoTitle       String?
  seoDescription String?
  displayOrder   Int       @default(0)
  visible        Boolean   @default(true)
  showOnHomepage Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products Product[]

  @@index([visible, displayOrder])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  sku                  String?       @unique
  status               ProductStatus @default(DRAFT)
  categoryId           String?
  category             Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shortDescription     String        @default("")
  description          String        @default("") // Markdown
  basePriceCents       Int?
  showPrice            Boolean       @default(true)
  // Sale: replaces the base price (options/add-ons unchanged) while
  // saleStartsAt <= now < saleEndsAt. Either bound may be open.
  salePriceCents       Int?
  saleStartsAt         DateTime?
  saleEndsAt           DateTime?
  featured             Boolean       @default(false)
  featuredOrder        Int           @default(0)
  // Future commerce: individual products can be excluded from online
  // purchase even when e-commerce is globally enabled (e.g. quote-only).
  purchasable          Boolean       @default(true)
  leadTime             String?
  dimensions           String? // Markdown
  materials            String? // Markdown
  construction         String? // Markdown
  careInstructions     String? // Markdown
  deliveryInfo         String? // Markdown
  seoTitle             String?
  seoDescription       String?
  // Internal cost assumptions used by the admin pricing calculator
  estMaterialCostCents Int?
  estLaborHours        Float?
  displayOrder         Int           @default(0)
  // Seeded demonstration content (removable in one click from the dashboard)
  isSample             Boolean       @default(false)
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  images       ProductImage[]
  videos       ProductVideo[]
  optionGroups ProductOptionGroup[]
  addOns       ProductAddOn[]
  quotes       QuoteRequest[]
  orderItems   OrderItem[]
  estimates    PriceEstimate[]

  @@index([status, displayOrder])
  @@index([categoryId])
  @@index([featured])
}

/// A product video. The file lives in object storage under media/ (public);
/// the poster frame is an ordinary Media image captured in the admin's
/// browser at upload time (there is no server-side video processing).
/// Duplicated products share the same file, so storage is only deleted when
/// the last row using a key is removed.
model ProductVideo {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey   String
  url          String
  originalName String
  mimeType     String
  size         Int // bytes
  width        Int
  height       Int
  durationSec  Float
  title        String     @default("") // accessible name / caption
  posterId     String?
  poster       Media?     @relation("VideoPoster", fields: [posterId], references: [id], onDelete: SetNull)
  sortOrder    Int        @default(0)
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([productId, sortOrder])
  @@index([storageKey])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  alt       String? // Overrides media alt text for this product
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
}

// ---------------------------------------------------------------------------
// Options (global library + per-product attachment/overrides)
// ---------------------------------------------------------------------------

enum OptionInputType {
  BUTTONS
  IMAGE
  SWATCH
  DROPDOWN
  RADIO
}

model OptionGroup {
  id           String          @id @default(cuid())
  name         String          @unique // internal, e.g. "Wood Species"
  displayName  String // shown to customers, e.g. "Wood"
  description  String?
  inputType    OptionInputType @default(BUTTONS)
  required     Boolean         @default(true)
  displayOrder Int             @default(0)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  values   OptionValue[]
  products ProductOptionGroup[]
}

model OptionValue {
  id                 String      @id @default(cuid())
  groupId            String
  group              OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name               String // internal
  displayName        String
  description        String?
  imageId            String?
  image              Media?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  swatchColor        String? // hex, for SWATCH groups
  priceModifierCents Int         @default(0)
  // "Custom" values (e.g. custom size) ask the customer for details and mark
  // the configuration as requiring a custom quote.
  isCustom           Boolean     @default(false)
  displayOrder       Int         @default(0)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  productOverrides ProductOptionValue[]

  @@unique([groupId, name])
  @@index([groupId, displayOrder])
}

model ProductOptionGroup {
  id                  String      @id @default(cuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroupId       String
  optionGroup         OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Restrict)
  displayOrder        Int         @default(0)
  // null = inherit from the global group
  requiredOverride    Boolean?
  displayNameOverride String?
  createdAt           DateTime    @default(now())

  valueOverrides ProductOptionValue[]

  @@unique([productId, optionGroupId])
  @@index([productId, displayOrder])
}

// Per-product override for a global option value. When no row exists the
// value inherits all global settings (so new global values appear
// automatically unless disabled here).
model ProductOptionValue {
  id                         String             @id @default(cuid())
  productOptionGroupId       String
  productOptionGroup         ProductOptionGroup @relation(fields: [productOptionGroupId], references: [id], onDelete: Cascade)
  optionValueId              String
  optionValue                OptionValue        @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  enabled                    Boolean            @default(true)
  priceModifierOverrideCents Int?
  displayOrderOverride       Int?
  isDefault                  Boolean            @default(false)

  @@unique([productOptionGroupId, optionValueId])
}

// ---------------------------------------------------------------------------
// Add-ons
// ---------------------------------------------------------------------------

enum AddOnScope {
  REUSABLE
  PRODUCT_SPECIFIC
}

model AddOn {
  id           String     @id @default(cuid())
  name         String
  description  String?
  priceCents   Int        @default(0)
  imageId      String?
  image        Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  scope        AddOnScope @default(REUSABLE)
  required     Boolean    @default(false)
  minQuantity  Int        @default(0)
  maxQuantity  Int        @default(1)
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products ProductAddOn[]

  @@index([active, displayOrder])
}

model ProductAddOn {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addOnId             String
  addOn               AddOn    @relation(fields: [addOnId], references: [id], onDelete: Restrict)
  enabled             Boolean  @default(true)
  priceOverrideCents  Int?
  requiredOverride    Boolean?
  minQuantityOverride Int?
  maxQuantityOverride Int?
  displayOrder        Int      @default(0)

  @@unique([productId, addOnId])
  @@index([productId, displayOrder])
}

// ---------------------------------------------------------------------------
// Portfolio / Our Work (separate from products)
// ---------------------------------------------------------------------------

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PortfolioProject {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  summary        String        @default("")
  description    String        @default("") // Markdown
  furnitureType  String?
  wood           String?
  finish         String?
  dimensions     String?
  location       String?
  status         PublishStatus @default(DRAFT)
  featured       Boolean       @default(false)
  featuredOrder  Int           @default(0)
  displayOrder   Int           @default(0)
  seoTitle       String?
  seoDescription String?
  isSample       Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images PortfolioImage[]

  @@index([status, displayOrder])
}

model PortfolioImage {
  id        String           @id @default(cuid())
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media            @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  alt       String?
  sortOrder Int              @default(0)
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@unique([projectId, mediaId])
  @@index([projectId, sortOrder])
}

// ---------------------------------------------------------------------------
// Inquiries: quotes, custom requests, contact messages
// ---------------------------------------------------------------------------

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
}

enum QuoteSource {
  CONFIGURATOR
  GENERAL
}

model QuoteRequest {
  id                  String      @id @default(cuid())
  reference           String      @unique
  status              QuoteStatus @default(NEW)
  source              QuoteSource @default(CONFIGURATOR)
  name                String
  email               String
  phone               String?
  zipCode             String
  // Product link is informational; the snapshot below is the source of truth.
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName         String?
  // Immutable ConfigurationSnapshot (see src/lib/pricing/snapshot.ts)
  configuration       Json?
  estimatedTotalCents Int?
  requestedDimensions String?
  notes               String?
  timeline            String?
  readAt              DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  attachments    Attachment[]
  internalNotes  InternalNote[]
  statusEvents   StatusEvent[]
  priceEstimates PriceEstimate[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
}

enum CustomRequestStatus {
  NEW
  REVIEWING
  CONTACTED
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
}

model CustomRequest {
  id                    String              @id @default(cuid())
  reference             String              @unique
  status                CustomRequestStatus @default(NEW)
  name                  String
  email                 String
  phone                 String?
  zipCode               String
  furnitureType         String
  approximateDimensions String?
  woodPreference        String?
  finishPreference      String?
  description           String
  timeline              String?
  readAt                DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  attachments   Attachment[]
  internalNotes InternalNote[]
  statusEvents  StatusEvent[]

  @@index([status, createdAt])
  @@index([createdAt])
}

enum ContactReason {
  PRODUCT_QUESTION
  CUSTOM_FURNITURE
  EXISTING_QUOTE
  DELIVERY_QUESTION
  OTHER
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  reason    ContactReason
  message   String
  status    MessageStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  internalNotes InternalNote[]
  statusEvents  StatusEvent[]

  @@index([status, createdAt])
}

// Customer-uploaded reference images. Kept private (served only to admins)
// and separate from the public Media library.
model Attachment {
  id              String         @id @default(cuid())
  storageKey      String         @unique
  filename        String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  quoteRequestId  String?
  quoteRequest    QuoteRequest?  @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  customRequestId String?
  customRequest   CustomRequest? @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([quoteRequestId])
  @@index([customRequestId])
}

model InternalNote {
  id               String          @id @default(cuid())
  body             String
  authorId         String?
  author           AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  quoteRequestId   String?
  quoteRequest     QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  customRequestId  String?
  customRequest    CustomRequest?  @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  contactMessageId String?
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([quoteRequestId])
  @@index([customRequestId])
  @@index([contactMessageId])
  @@index([orderId])
}

// Status history for quotes, custom requests, messages and (future) orders.
model StatusEvent {
  id               String          @id @default(cuid())
  fromStatus       String?
  toStatus         String
  authorId         String?
  author           AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  quoteRequestId   String?
  quoteRequest     QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  customRequestId  String?
  customRequest    CustomRequest?  @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  contactMessageId String?
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([quoteRequestId])
  @@index([customRequestId])
  @@index([contactMessageId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// FAQ
// ---------------------------------------------------------------------------

model FaqCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faqs Faq[]
}

model Faq {
  id                 String       @id @default(cuid())
  question           String
  answer             String // Markdown
  categoryId         String?
  category           FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  displayOrder       Int          @default(0)
  visible            Boolean      @default(true)
  showOnProductPages Boolean      @default(false)
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([categoryId, displayOrder])
}

// ---------------------------------------------------------------------------
// Structured CMS pages
//
// Code defines which sections a page has and how they render (see
// src/lib/cms/page-definitions.ts). The database holds all copy, imagery and
// visibility. Policy pages use the markdown `body`.
// ---------------------------------------------------------------------------

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique // "home", "about", "shipping-delivery" …
  title          String
  body           String? // Markdown, used by content/policy pages
  status         PublishStatus @default(PUBLISHED)
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  ogImage        Media?        @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  // Flags draft policy language that should receive owner/legal review.
  reviewRequired Boolean       @default(false)
  reviewNotes    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sections PageSection[]
}

model PageSection {
  id                String   @id @default(cuid())
  pageId            String
  page              Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key               String // stable identifier from the page definition, e.g. "hero"
  visible           Boolean  @default(true)
  displayOrder      Int      @default(0)
  eyebrow           String?
  heading           String?
  subheading        String?
  body              String? // Markdown
  imageId           String?
  image             Media?   @relation("SectionImage", fields: [imageId], references: [id], onDelete: SetNull)
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  updatedAt         DateTime @updatedAt

  items SectionItem[]

  @@unique([pageId, key])
}

// Repeating items inside a section (process steps, craftsmanship pillars,
// gallery images …).
model SectionItem {
  id           String      @id @default(cuid())
  sectionId    String
  section      PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  eyebrow      String?
  title        String?
  body         String?
  imageId      String?
  image        Media?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  linkLabel    String?
  linkHref     String?
  displayOrder Int         @default(0)
  visible      Boolean     @default(true)

  @@index([sectionId, displayOrder])
}

// ---------------------------------------------------------------------------
// Site settings & feature flags (single row, id = "default")
// ---------------------------------------------------------------------------

model SiteSetting {
  id                           String   @id @default("default")
  businessName                 String   @default("Wild Mountain Woodworks")
  tagline                      String   @default("Built by hand. Made to belong.")
  brandStatement               String?
  email                        String?
  phone                        String?
  locationText                 String? // e.g. "Ohio"
  serviceAreaText              String?
  addressLocality              String?
  addressRegion                String?
  instagramUrl                 String?
  facebookUrl                  String?
  pinterestUrl                 String?
  houzzUrl                     String?
  defaultSeoTitle              String?
  defaultSeoDescription        String?
  defaultOgImageId             String?
  defaultOgImage               Media?   @relation("SettingsOgImage", fields: [defaultOgImageId], references: [id], onDelete: SetNull)
  defaultLeadTime              String?
  priceDisclaimer              String?
  quoteConfirmationText        String?
  notificationEmail            String?
  // Feature flags
  showPrices                   Boolean  @default(true)
  quotesEnabled                Boolean  @default(true)
  customOrdersEnabled          Boolean  @default(true)
  ecommerceEnabled             Boolean  @default(false)
  // Internal pricing calculator defaults (never shown publicly)
  pricingLaborRateCents        Int      @default(4500)
  pricingLumberWastePct        Float    @default(15)
  pricingMaterialWastePct      Float    @default(0)
  pricingOverheadPct           Float    @default(5)
  pricingOverheadMethod        String   @default("percent") // "percent" | "allocated"
  pricingMonthlyOverheadCents  Int      @default(0)
  pricingProjectsPerMonth      Int      @default(4)
  pricingTargetMarginPct       Float    @default(35)
  pricingMinMarginWarnPct      Float    @default(25)
  pricingMaterialsLaborWarnPct Float    @default(50)
  pricingDepositPct            Float    @default(50)
  pricingRoundToDollars        Int      @default(50) // round recommendations UP to this many dollars (0 = off)
  updatedAt                    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Future commerce (not exposed while ecommerceEnabled = false)
//
// Guest checkout via Stripe-hosted Checkout. No card data is ever stored —
// only Stripe object IDs.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum ProductionStatus {
  ORDER_RECEIVED
  DESIGN_CONFIRMATION
  MATERIALS_PREPARED
  IN_PRODUCTION
  FINISHING
  READY_FOR_DELIVERY
  COMPLETED
}

model Order {
  id                      String           @id @default(cuid())
  number                  String           @unique
  status                  OrderStatus      @default(PENDING_PAYMENT)
  paymentStatus           PaymentStatus    @default(UNPAID)
  productionStatus        ProductionStatus @default(ORDER_RECEIVED)
  customerName            String
  customerEmail           String
  customerPhone           String?
  shippingAddress         Json?
  subtotalCents           Int
  discountCents           Int              @default(0)
  shippingCents           Int              @default(0)
  taxCents                Int              @default(0)
  totalCents              Int
  currency                String           @default("usd")
  promoCode               String?
  stripeCheckoutSessionId String?          @unique
  stripePaymentIntentId   String?          @unique
  customerNotes           String?
  paidAt                  DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  items         OrderItem[]
  internalNotes InternalNote[]
  statusEvents  StatusEvent[]

  @@index([status, createdAt])
  @@index([customerEmail])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  sku            String?
  // Immutable ConfigurationSnapshot, priced server-side at order creation.
  configuration  Json
  unitPriceCents Int
  quantity       Int      @default(1)
  lineTotalCents Int
  createdAt      DateTime @default(now())

  @@index([orderId])
}

// Simple fixed-window rate limiting shared across instances.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ---------------------------------------------------------------------------
// Internal pricing calculator (admin only — never exposed publicly)
// ---------------------------------------------------------------------------

model PriceEstimate {
  id                    String        @id @default(cuid())
  name                  String
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  customerZip           String?
  productId             String?
  product               Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  quoteRequestId        String?
  quoteRequest          QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  // Project details
  productType           String?
  dimensions            String?
  woodSpecies           String?
  // Full calculator inputs (line items, labor phases, adjustments …)
  inputs                Json
  // Results recalculated on the server at save time
  materialCostCents     Int
  suppliesCostCents     Int           @default(0)
  otherDirectCostCents  Int           @default(0)
  laborHours            Float         @default(0)
  laborCostCents        Int
  overheadCostCents     Int
  totalCostCents        Int
  targetMarginPct       Float
  floorCents            Int // material cost ÷ 0.30
  detailedPriceCents    Int? // total cost ÷ (1 − margin)
  baseRecommendedCents  Int           @default(0) // MAX(floor, detailed)
  valueAdjustmentCents  Int           @default(0)
  finalRecommendedCents Int           @default(0)
  fiftyCheckCents       Int
  finalPriceCents       Int? // final selling price (manual or recommended)
  manualPrice           Boolean       @default(false)
  depositPct            Float         @default(50)
  depositCents          Int           @default(0)
  balanceCents          Int           @default(0)
  grossProfitCents      Int           @default(0)
  grossMarginPct        Float?
  netProfitCents        Int           @default(0)
  notes                 String?
  archivedAt            DateTime?
  createdById           String?
  createdBy             AdminUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([archivedAt, updatedAt])
  @@index([productId])
}
