// Wild Mountain Woodworks — database schema
//
// Design notes
// - Money is stored as integer cents (USD) everywhere. Never floats.
// - Images are NEVER stored in the database. `Media` rows hold metadata and the
//   object-storage key/URL (Cloudflare R2 in production). Every public-facing
//   photograph is referenced through a foreign key to `Media`, which is what
//   powers "this image is used in N locations" and safe deletion.
// - Quotes and orders store immutable configuration SNAPSHOTS (JSON) so later
//   edits to products/options never rewrite what a customer requested.
// - Records that historical data depends on are archived, not deleted.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Administration
// ---------------------------------------------------------------------------

/// OWNER: full control, including admin users, roles and security.
/// ADMIN: products, quotes, content, media and ordinary site management.
/// OWNER: everything. ADMIN: ordinary site management (no admin users or
/// owner security). EDITOR: editorial/CMS work only. The permission matrix is
/// src/lib/auth/permissions.ts, enforced server-side.
enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

/// Admin accounts. Authentication (password hashing, sessions, two-factor)
/// is handled by Better Auth (src/lib/auth/auth.ts); these tables follow its
/// schema. There is no public sign-up: accounts are created by an owner in
/// Admin → Security or by the controlled bootstrap (seed / admin:create).
model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  emailVerified    Boolean   @default(true)
  image            String?
  role             AdminRole @default(ADMIN)
  active           Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relation names follow Better Auth's Prisma adapter convention
  // (lower-cased model name + "s"), which it uses for joins.
  adminsessions   AdminSession[]
  adminaccounts   AdminAccount[]
  admintwofactors AdminTwoFactor[]
  activities      ActivityLog[]
  notes           InternalNote[]
  statusEvents    StatusEvent[]
  mediaUploads    Media[]
  videoUploads    ProductVideo[]
  estimates       PriceEstimate[]
  pagesCreated    Page[]           @relation("PageCreatedBy")
  pagesEdited     Page[]           @relation("PageUpdatedBy")
}

/// Server-side admin sessions (Better Auth). The cookie holds the token plus
/// an HMAC signature made with BETTER_AUTH_SECRET, so a database leak alone
/// can't be turned into a valid cookie. Revoking = deleting the row.
model AdminSession {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

/// Credential store (Better Auth "account"). `password` is a scrypt hash
/// (legacy bcrypt hashes are still verified and upgraded on next sign-in).
model AdminAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Short-lived verification values (e.g. the pending two-factor challenge).
model AdminVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// TOTP secret and backup codes, both encrypted with BETTER_AUTH_SECRET.
model AdminTwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
}

model ActivityLog {
  id         String     @id @default(cuid())
  type       String // e.g. product.published, quote.status_changed
  message    String
  entityType String?
  entityId   String?
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Media library (metadata only — binaries live in object storage)
// ---------------------------------------------------------------------------

model Media {
  id           String     @id @default(cuid())
  storageKey   String     @unique
  url          String
  filename     String
  originalName String
  mimeType     String
  size         Int // bytes
  width        Int
  height       Int
  alt          String     @default("")
  caption      String?
  // Focal point (0-100 %) used when an image is cropped for a design
  // location's aspect ratio. The original file is never altered.
  focalX       Int        @default(50)
  focalY       Int        @default(50)
  // Tiny base64 blur placeholder for progressive loading.
  blurDataUrl  String?
  isSample     Boolean    @default(false)
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  productImages    ProductImage[]
  portfolioImages  PortfolioImage[]
  categories       Category[]
  optionValues     OptionValue[]
  addOns           AddOn[]
  pageSections     PageSection[]    @relation("SectionImage")
  pageSectionItems SectionItem[]
  pagesOg          Page[]           @relation("PageOgImage")
  settingsOg       SiteSetting[]    @relation("SettingsOgImage")
  videoPosters     ProductVideo[]   @relation("VideoPoster")
  salesAttachments SalesAttachment[]

  @@index([createdAt])
  @@index([filename])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id             String    @id @default(cuid())
  menuItems      MenuItem[]
  name           String
  slug           String    @unique
  description    String?
  imageId        String?
  image          Media?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  // Optional destination override. e.g. a "Custom Furniture" tile on the
  // homepage that links to /custom-furniture instead of a product listing.
  linkUrl        String?
  seoTitle       String?
  seoDescription String?
  displayOrder   Int       @default(0)
  visible        Boolean   @default(true)
  showOnHomepage Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products Product[]

  @@index([visible, displayOrder])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SaleType {
  PERCENT
  FIXED_PRICE
}

model Product {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  sku                  String?       @unique
  status               ProductStatus @default(DRAFT)
  categoryId           String?
  category             Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  shortDescription     String        @default("")
  description          String        @default("") // Markdown
  basePriceCents       Int?
  showPrice            Boolean       @default(true)
  // Sale: while saleEnabled and saleStartsAt <= now < saleEndsAt (either
  // bound may be open), the sale price replaces the base (regular) price;
  // options and add-ons are unchanged.
  saleEnabled          Boolean       @default(false)
  // How the sale was entered. PERCENT: salePercentBps (hundredths of a
  // percent, 3000 = 30%) is the source of truth; the sale price is derived
  // from the current regular price and rounded to the dollar, and the
  // advertised discount is always the entered percentage. FIXED_PRICE:
  // salePriceCents is the source of truth and the discount % is derived.
  saleType             SaleType?
  salePercentBps       Int?
  salePriceCents       Int? // FIXED_PRICE only
  saleStartsAt         DateTime?
  saleEndsAt           DateTime?
  saleLabel            String? // e.g. "Fall Sale" — shown instead of "Sale"
  featured             Boolean       @default(false)
  featuredOrder        Int           @default(0)
  // Future commerce: individual products can be excluded from online
  // purchase even when e-commerce is globally enabled (e.g. quote-only).
  purchasable          Boolean       @default(true)
  leadTime             String?
  dimensions           String? // Markdown
  materials            String? // Markdown
  construction         String? // Markdown
  careInstructions     String? // Markdown
  deliveryInfo         String? // Markdown
  seoTitle             String?
  seoDescription       String?
  // Internal cost assumptions used by the admin pricing calculator
  estMaterialCostCents Int?
  estLaborHours        Float?
  displayOrder         Int           @default(0)
  // Seeded demonstration content (removable in one click from the dashboard)
  isSample             Boolean       @default(false)
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  images       ProductImage[]
  videos       ProductVideo[]
  optionGroups ProductOptionGroup[]
  addOns       ProductAddOn[]
  quotes       QuoteRequest[]
  orderItems   OrderItem[]
  estimates    PriceEstimate[]
  menuItems    MenuItem[]
  quoteLines   QuoteLineItem[]

  @@index([status, displayOrder])
  @@index([categoryId])
  @@index([saleEnabled, saleStartsAt, saleEndsAt])
  @@index([featured])
}

/// A product video. The file lives in object storage under media/ (public);
/// the poster frame is an ordinary Media image captured in the admin's
/// browser at upload time (there is no server-side video processing).
/// Duplicated products share the same file, so storage is only deleted when
/// the last row using a key is removed.
model ProductVideo {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey   String
  url          String
  originalName String
  mimeType     String
  size         Int // bytes
  width        Int
  height       Int
  durationSec  Float
  title        String     @default("") // accessible name / caption
  posterId     String?
  poster       Media?     @relation("VideoPoster", fields: [posterId], references: [id], onDelete: SetNull)
  sortOrder    Int        @default(0)
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([productId, sortOrder])
  @@index([storageKey])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  alt       String? // Overrides media alt text for this product
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
}

// ---------------------------------------------------------------------------
// Options (global library + per-product attachment/overrides)
// ---------------------------------------------------------------------------

enum OptionInputType {
  BUTTONS
  IMAGE
  SWATCH
  DROPDOWN
  RADIO
}

model OptionGroup {
  id           String          @id @default(cuid())
  name         String          @unique // internal, e.g. "Wood Species"
  displayName  String // shown to customers, e.g. "Wood"
  description  String?
  inputType    OptionInputType @default(BUTTONS)
  required     Boolean         @default(true)
  displayOrder Int             @default(0)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  values   OptionValue[]
  products ProductOptionGroup[]
}

model OptionValue {
  id                 String      @id @default(cuid())
  groupId            String
  group              OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name               String // internal
  displayName        String
  description        String?
  imageId            String?
  image              Media?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  swatchColor        String? // hex, for SWATCH groups
  priceModifierCents Int         @default(0)
  // "Custom" values (e.g. custom size) ask the customer for details and mark
  // the configuration as requiring a custom quote.
  isCustom           Boolean     @default(false)
  displayOrder       Int         @default(0)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  productOverrides ProductOptionValue[]

  @@unique([groupId, name])
  @@index([groupId, displayOrder])
}

model ProductOptionGroup {
  id                  String      @id @default(cuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroupId       String
  optionGroup         OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Restrict)
  displayOrder        Int         @default(0)
  // null = inherit from the global group
  requiredOverride    Boolean?
  displayNameOverride String?
  createdAt           DateTime    @default(now())

  valueOverrides ProductOptionValue[]

  @@unique([productId, optionGroupId])
  @@index([productId, displayOrder])
}

// Per-product override for a global option value. When no row exists the
// value inherits all global settings (so new global values appear
// automatically unless disabled here).
model ProductOptionValue {
  id                         String             @id @default(cuid())
  productOptionGroupId       String
  productOptionGroup         ProductOptionGroup @relation(fields: [productOptionGroupId], references: [id], onDelete: Cascade)
  optionValueId              String
  optionValue                OptionValue        @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  enabled                    Boolean            @default(true)
  priceModifierOverrideCents Int?
  displayOrderOverride       Int?
  isDefault                  Boolean            @default(false)

  @@unique([productOptionGroupId, optionValueId])
}

// ---------------------------------------------------------------------------
// Add-ons
// ---------------------------------------------------------------------------

enum AddOnScope {
  REUSABLE
  PRODUCT_SPECIFIC
}

model AddOn {
  id           String     @id @default(cuid())
  name         String
  description  String?
  priceCents   Int        @default(0)
  imageId      String?
  image        Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull)
  scope        AddOnScope @default(REUSABLE)
  required     Boolean    @default(false)
  minQuantity  Int        @default(0)
  maxQuantity  Int        @default(1)
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products ProductAddOn[]

  @@index([active, displayOrder])
}

model ProductAddOn {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addOnId             String
  addOn               AddOn    @relation(fields: [addOnId], references: [id], onDelete: Restrict)
  enabled             Boolean  @default(true)
  priceOverrideCents  Int?
  requiredOverride    Boolean?
  minQuantityOverride Int?
  maxQuantityOverride Int?
  displayOrder        Int      @default(0)

  @@unique([productId, addOnId])
  @@index([productId, displayOrder])
}

// ---------------------------------------------------------------------------
// Portfolio / Our Work (separate from products)
// ---------------------------------------------------------------------------

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PortfolioProject {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  summary        String        @default("")
  description    String        @default("") // Markdown
  furnitureType  String?
  wood           String?
  finish         String?
  dimensions     String?
  location       String?
  status         PublishStatus @default(DRAFT)
  featured       Boolean       @default(false)
  featuredOrder  Int           @default(0)
  displayOrder   Int           @default(0)
  seoTitle       String?
  seoDescription String?
  isSample       Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images PortfolioImage[]

  @@index([status, displayOrder])
}

model PortfolioImage {
  id        String           @id @default(cuid())
  projectId String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media            @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  alt       String?
  sortOrder Int              @default(0)
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@unique([projectId, mediaId])
  @@index([projectId, sortOrder])
}

// ---------------------------------------------------------------------------
// Inquiries: quotes, custom requests, contact messages
// ---------------------------------------------------------------------------

/// Overall quote workflow. Admins may move between states when they need
/// to intervene; customer-facing transitions are enforced in src/lib/sales.
enum QuoteStatus {
  NEW
  REVIEWING
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED_TO_INVOICE
  CANCELED
  COMPLETED
  /// No longer valid: kept forever, but can't be accepted, invoiced or paid.
  VOIDED
}

/// Status of one revision of a quote. Only the current revision can be
/// accepted, and only while SENT (and not expired).
enum RevisionStatus {
  DRAFT
  SENT
  SUPERSEDED
  ACCEPTED
  DECLINED
}

enum DepositType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
}

/// Quote/invoice line kinds. Discounts are negative amounts; delivery,
/// installation and fees are totalled separately from merchandise.
enum LineItemKind {
  PRODUCT
  ADDON
  CUSTOM
  DISCOUNT
  DELIVERY
  INSTALLATION
  FEE
}

enum QuoteSource {
  CONFIGURATOR
  GENERAL
  /// Created by an admin (phone, email, in person).
  MANUAL
  /// Created from a pricing-calculator estimate.
  ESTIMATE
}

/// A customer's quote: the original request (snapshot of what they
/// configured) plus Wild Mountain's priced revisions. Also used for general
/// and manually created quotes.
model QuoteRequest {
  id                  String      @id @default(cuid())
  /// Legacy random reference (WM-Q-…); kept for old links and emails.
  reference           String      @unique
  /// Customer-facing number, e.g. WMQ-1001.
  number              String?     @unique
  status              QuoteStatus @default(NEW)
  customerId          String?
  customer            Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Unguessable token for /quote/[token] (never a database id).
  customerToken       String?     @unique
  currentRevisionId   String?     @unique
  currentRevision     QuoteRevision? @relation("QuoteCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  acceptedRevisionId  String?     @unique
  acceptedRevision    QuoteRevision? @relation("QuoteAcceptedRevision", fields: [acceptedRevisionId], references: [id], onDelete: SetNull)
  quantity            Int         @default(1)
  address             String?
  archivedAt          DateTime?
  /// Voiding (never deleting): who, when, why, and the status to restore on reopen.
  voidedAt            DateTime?
  voidedById          String?
  voidReason          String?
  voidedFromStatus    QuoteStatus?
  createdById         String?
  source              QuoteSource @default(CONFIGURATOR)
  name                String
  email               String
  phone               String?
  zipCode             String
  // Product link is informational; the snapshot below is the source of truth.
  productId           String?
  product             Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName         String?
  // Immutable ConfigurationSnapshot (see src/lib/pricing/snapshot.ts)
  configuration       Json?
  estimatedTotalCents Int?
  requestedDimensions String?
  notes               String?
  timeline            String?
  readAt              DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  attachments    Attachment[]
  internalNotes  InternalNote[]
  statusEvents   StatusEvent[]
  priceEstimates PriceEstimate[]
  revisions      QuoteRevision[] @relation("QuoteRevisions")
  invoices       Invoice[]
  orders         Order[]
  activities     CustomerActivity[]
  emails         EmailLog[]
  files          SalesAttachment[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
  @@index([customerId])
}

/// One priced version of a quote. Sent revisions are never edited: changes
/// create a new revision (Revision 2, 3 …) and the previous one becomes
/// SUPERSEDED when the new one is sent. Everything the customer sees is
/// stored here — never read from live product data.
model QuoteRevision {
  id                  String         @id @default(cuid())
  quoteId             String
  quote               QuoteRequest   @relation("QuoteRevisions", fields: [quoteId], references: [id], onDelete: Cascade)
  number              Int
  status              RevisionStatus @default(DRAFT)
  customerName        String
  customerEmail       String
  customerPhone       String?
  customerAddress     String?
  /// Customer-facing notes (internal notes live in InternalNote).
  customerNotes       String?
  /// Terms (Markdown) as shown on this revision.
  terms               String?
  expiresAt           DateTime?
  leadTime            String?
  estimatedCompletion String?
  deliveryDetails     String?
  depositType         DepositType    @default(NONE)
  depositPercentBps   Int?
  depositAmountCents  Int?
  taxCents            Int            @default(0)
  // Totals, recomputed from the lines on every save (integer cents).
  subtotalCents       Int            @default(0)
  discountCents       Int            @default(0)
  deliveryCents       Int            @default(0)
  otherChargesCents   Int            @default(0)
  totalCents          Int            @default(0)
  depositCents        Int            @default(0)
  balanceCents        Int            @default(0)
  sentAt              DateTime?
  viewedAt            DateTime?
  acceptedAt          DateTime?
  acceptedName        String?
  acceptedIp          String?
  acceptedUserAgent   String?
  /// Exact lines, totals, deposit and terms at acceptance (frozen).
  acceptedSnapshot    Json?
  acceptedManuallyById String?
  declinedAt          DateTime?
  declineReason       String?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lineItems        QuoteLineItem[]
  currentOf        QuoteRequest?  @relation("QuoteCurrentRevision")
  acceptedOf       QuoteRequest?  @relation("QuoteAcceptedRevision")
  invoices         Invoice[]
  orders           Order[]

  @@unique([quoteId, number])
}

model QuoteLineItem {
  id             String        @id @default(cuid())
  revisionId     String
  revision       QuoteRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  position       Int
  kind           LineItemKind  @default(CUSTOM)
  description    String
  notes          String?
  quantity       Int           @default(1)
  /// Negative for discounts.
  unitPriceCents Int
  lineTotalCents Int
  /// Prepared for future tax rules; tax is off until configured.
  taxable        Boolean       @default(true)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// ConfigurationSnapshot of the configured piece (optional).
  configuration  Json?

  @@index([revisionId, position])
}

enum CustomRequestStatus {
  NEW
  REVIEWING
  CONTACTED
  QUOTED
  ACCEPTED
  DECLINED
  COMPLETED
}

model CustomRequest {
  id                    String              @id @default(cuid())
  reference             String              @unique
  status                CustomRequestStatus @default(NEW)
  name                  String
  email                 String
  phone                 String?
  zipCode               String
  furnitureType         String
  approximateDimensions String?
  woodPreference        String?
  finishPreference      String?
  description           String
  timeline              String?
  readAt                DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  attachments   Attachment[]
  internalNotes InternalNote[]
  statusEvents  StatusEvent[]

  @@index([status, createdAt])
  @@index([createdAt])
}

enum ContactReason {
  PRODUCT_QUESTION
  CUSTOM_FURNITURE
  EXISTING_QUOTE
  DELIVERY_QUESTION
  OTHER
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  reason    ContactReason
  message   String
  status    MessageStatus @default(UNREAD)
  readAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  internalNotes InternalNote[]
  statusEvents  StatusEvent[]

  @@index([status, createdAt])
}

// Customer-uploaded reference images. Kept private (served only to admins)
// and separate from the public Media library.
model Attachment {
  id              String         @id @default(cuid())
  storageKey      String         @unique
  filename        String
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  quoteRequestId  String?
  quoteRequest    QuoteRequest?  @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  customRequestId String?
  customRequest   CustomRequest? @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())

  @@index([quoteRequestId])
  @@index([customRequestId])
}

model InternalNote {
  id               String          @id @default(cuid())
  body             String
  authorId         String?
  author           AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  quoteRequestId   String?
  quoteRequest     QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  customRequestId  String?
  customRequest    CustomRequest?  @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  contactMessageId String?
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId        String?
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([quoteRequestId])
  @@index([customRequestId])
  @@index([contactMessageId])
  @@index([orderId])
  @@index([customerId])
  @@index([invoiceId])
}

// Status history for quotes, custom requests, messages and (future) orders.
model StatusEvent {
  id               String          @id @default(cuid())
  fromStatus       String?
  toStatus         String
  authorId         String?
  author           AdminUser?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  quoteRequestId   String?
  quoteRequest     QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  customRequestId  String?
  customRequest    CustomRequest?  @relation(fields: [customRequestId], references: [id], onDelete: Cascade)
  contactMessageId String?
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceId        String?
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())

  @@index([quoteRequestId])
  @@index([customRequestId])
  @@index([contactMessageId])
  @@index([orderId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// FAQ
// ---------------------------------------------------------------------------

model FaqCategory {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faqs Faq[]
}

model Faq {
  id                 String       @id @default(cuid())
  question           String
  answer             String // Markdown
  categoryId         String?
  category           FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  displayOrder       Int          @default(0)
  visible            Boolean      @default(true)
  showOnProductPages Boolean      @default(false)
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([categoryId, displayOrder])
}

// ---------------------------------------------------------------------------
// Structured CMS pages
//
// Code defines which sections a page has and how they render (see
// src/lib/cms/page-definitions.ts). The database holds all copy, imagery and
// visibility. Policy pages use the markdown `body`.
// ---------------------------------------------------------------------------

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique // "home", "about", "shipping-delivery" …
  title          String
  body           String? // Markdown, used by content/policy pages
  status         PublishStatus @default(PUBLISHED)
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  ogImage        Media?        @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  // Flags draft policy language that should receive owner/legal review.
  reviewRequired Boolean       @default(false)
  reviewNotes    String?
  /// Pages created in Admin → Pages (public at /{slug}, "custom" template).
  /// Other pages are defined in src/lib/cms/definitions.ts.
  isCustom       Boolean       @default(false)
  /// Optional shorter label used when the page is added to a menu.
  navLabel       String?
  publishedAt    DateTime?
  createdById    String?
  createdBy      AdminUser?    @relation("PageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      AdminUser?    @relation("PageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sections  PageSection[]
  menuItems MenuItem[]

  @@index([status])
}

model PageSection {
  id                String   @id @default(cuid())
  pageId            String
  page              Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key               String // stable identifier from the page definition, e.g. "hero"
  visible           Boolean  @default(true)
  displayOrder      Int      @default(0)
  eyebrow           String?
  heading           String?
  subheading        String?
  body              String? // Markdown
  imageId           String?
  image             Media?   @relation("SectionImage", fields: [imageId], references: [id], onDelete: SetNull)
  primaryCtaLabel   String?
  primaryCtaHref    String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  updatedAt         DateTime @updatedAt

  items SectionItem[]

  @@unique([pageId, key])
}

// Repeating items inside a section (process steps, craftsmanship pillars,
// gallery images …).
model SectionItem {
  id           String      @id @default(cuid())
  sectionId    String
  section      PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  eyebrow      String?
  title        String?
  body         String?
  imageId      String?
  image        Media?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  linkLabel    String?
  linkHref     String?
  displayOrder Int         @default(0)
  visible      Boolean     @default(true)

  @@index([sectionId, displayOrder])
}

// ---------------------------------------------------------------------------
// Site settings & feature flags (single row, id = "default")
// ---------------------------------------------------------------------------

model SiteSetting {
  id                           String   @id @default("default")
  businessName                 String   @default("Wild Mountain Woodworks")
  tagline                      String   @default("Built by hand. Made to belong.")
  brandStatement               String?
  email                        String?
  phone                        String?
  locationText                 String? // e.g. "Ohio"
  serviceAreaText              String?
  addressLocality              String?
  addressRegion                String?
  instagramUrl                 String?
  facebookUrl                  String?
  pinterestUrl                 String?
  houzzUrl                     String?
  defaultSeoTitle              String?
  defaultSeoDescription        String?
  defaultOgImageId             String?
  defaultOgImage               Media?   @relation("SettingsOgImage", fields: [defaultOgImageId], references: [id], onDelete: SetNull)
  defaultLeadTime              String?
  priceDisclaimer              String?
  quoteConfirmationText        String?
  notificationEmail            String?
  // Feature flags
  showPrices                   Boolean  @default(true)
  quotesEnabled                Boolean  @default(true)
  customOrdersEnabled          Boolean  @default(true)
  /// Stripe invoicing (hosted invoice pages, payment links, webhooks).
  /// Also needs STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET. Formerly
  /// "ecommerceEnabled" (cart/checkout, never launched).
  stripeInvoicingEnabled       Boolean  @default(false)
  /// Taxes stay off until the business configures them.
  taxEnabled                   Boolean  @default(false)
  /// WILD_MOUNTAIN: branded email with the payment link; STRIPE: Stripe emails the invoice.
  invoiceEmailMode             String   @default("WILD_MOUNTAIN")
  quoteValidDays               Int      @default(30)
  invoiceDueDays               Int      @default(14)
  defaultDepositType           DepositType @default(PERCENTAGE)
  defaultDepositPercentBps     Int      @default(5000)
  defaultDepositAmountCents    Int?
  /// Default customer-facing terms (Markdown) copied onto new quote revisions.
  defaultQuoteTerms            String?
  /// How to pay offline (check payable to…, bank transfer details). Shown on
  /// invoices and invoice emails when Stripe invoicing is off.
  paymentInstructions          String?
  /// Customer-facing payment messaging only. These never enable or disable a
  /// payment method in Stripe — Stripe Checkout decides what's eligible.
  /// Shown only while online payments (Stripe) are on.
  paymentFinancingMessaging    Boolean  @default(true)
  paymentAffirmMessaging       Boolean  @default(true)
  paymentKlarnaMessaging       Boolean  @default(true)
  paymentMethodsMessaging      Boolean  @default(true)
  paymentMessagingHeading      String   @default("Flexible payment options available")
  /// Null = automatic wording from the Affirm/Klarna switches.
  paymentMessagingText         String?
  paymentMethodsText           String   @default("Card · Bank · Apple Pay · Link · Cash App Pay · Amazon Pay · Affirm · Klarna")
  /// Dashboard alert: NEW quotes older than this many days.
  quoteAlertDays               Int      @default(3)
  // Internal pricing calculator defaults (never shown publicly)
  pricingLaborRateCents        Int      @default(4500)
  pricingLumberWastePct        Float    @default(15)
  pricingMaterialWastePct      Float    @default(0)
  pricingOverheadPct           Float    @default(5)
  pricingOverheadMethod        String   @default("percent") // "percent" | "allocated"
  pricingMonthlyOverheadCents  Int      @default(0)
  pricingProjectsPerMonth      Int      @default(4)
  pricingTargetMarginPct       Float    @default(35)
  pricingMinMarginWarnPct      Float    @default(25)
  pricingMaterialsLaborWarnPct Float    @default(50)
  pricingDepositPct            Float    @default(50)
  pricingRoundToDollars        Int      @default(50) // round recommendations UP to this many dollars (0 = off)
  updatedAt                    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Future commerce (not exposed while ecommerceEnabled = false)
//
// Guest checkout via Stripe-hosted Checkout. No card data is ever stored —
// only Stripe object IDs.
// ---------------------------------------------------------------------------

/// Shop progress, separate from payment and delivery.
enum ProductionStatus {
  QUOTE_ACCEPTED
  AWAITING_DEPOSIT
  DEPOSIT_PAID
  DESIGN_CONFIRMATION
  MATERIALS_ORDERED
  MATERIALS_READY
  IN_PRODUCTION
  SANDING
  FINISHING
  CURING
  READY_FOR_DELIVERY
  DELIVERY_SCHEDULED
  COMPLETED
  CANCELED
}

/// Money state of an order, derived from its invoices and payments.
enum OrderPaymentStatus {
  UNPAID
  DEPOSIT_DUE
  PARTIALLY_PAID
  PAID
  REFUNDED
  CANCELED
}

enum DeliveryStatus {
  NOT_SCHEDULED
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  PICKUP_READY
  PICKED_UP
}

/// A piece (or set) being built, created from an accepted quote.
model Order {
  id                      String             @id @default(cuid())
  /// Customer-facing number, e.g. WMO-1001.
  number                  String             @unique
  productionStatus        ProductionStatus   @default(QUOTE_ACCEPTED)
  paymentStatus           OrderPaymentStatus @default(UNPAID)
  deliveryStatus          DeliveryStatus     @default(NOT_SCHEDULED)
  customerId              String?
  customer                Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteId                 String?
  quote                   QuoteRequest?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  acceptedRevisionId      String?
  acceptedRevision        QuoteRevision?     @relation(fields: [acceptedRevisionId], references: [id], onDelete: SetNull)
  /// Unguessable token for /order/[token].
  customerToken           String?            @unique
  customerName            String
  customerEmail           String
  customerPhone           String?
  shippingAddress         Json?
  deliveryAddress         String?
  deliveryDate            DateTime?
  deliveryNotes           String?
  estimatedCompletion     String?
  subtotalCents           Int
  discountCents           Int                @default(0)
  shippingCents           Int                @default(0)
  taxCents                Int                @default(0)
  totalCents              Int
  depositCents            Int                @default(0)
  currency                String             @default("usd")
  promoCode               String?
  /// Legacy (pre quote → invoice design); unused.
  stripeCheckoutSessionId String?            @unique
  stripePaymentIntentId   String?            @unique
  /// Customer-facing notes (internal notes live in InternalNote).
  customerNotes           String?
  /// Shop notes printed on the work order.
  productionNotes         String?
  paidAt                  DateTime?
  completedAt             DateTime?
  canceledAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  items         OrderItem[]
  internalNotes InternalNote[]
  statusEvents  StatusEvent[]
  invoices      Invoice[]
  payments      Payment[]
  activities    CustomerActivity[]
  emails        EmailLog[]
  files         SalesAttachment[]

  @@index([productionStatus, createdAt])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@index([customerId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  sku            String?
  // Snapshot of the accepted quote line (ConfigurationSnapshot for configured pieces).
  configuration  Json
  description    String?
  notes          String?
  kind           LineItemKind @default(PRODUCT)
  position       Int          @default(0)
  unitPriceCents Int
  quantity       Int      @default(1)
  lineTotalCents Int
  createdAt      DateTime @default(now())

  @@index([orderId])
}

// Simple fixed-window rate limiting shared across instances.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// ---------------------------------------------------------------------------
// Internal pricing calculator (admin only — never exposed publicly)
// ---------------------------------------------------------------------------

model PriceEstimate {
  id                    String        @id @default(cuid())
  name                  String
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  customerZip           String?
  productId             String?
  product               Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  quoteRequestId        String?
  quoteRequest          QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  // Project details
  productType           String?
  dimensions            String?
  woodSpecies           String?
  // Full calculator inputs (line items, labor phases, adjustments …)
  inputs                Json
  // Results recalculated on the server at save time
  materialCostCents     Int
  suppliesCostCents     Int           @default(0)
  otherDirectCostCents  Int           @default(0)
  laborHours            Float         @default(0)
  laborCostCents        Int
  overheadCostCents     Int
  totalCostCents        Int
  targetMarginPct       Float
  floorCents            Int // material cost ÷ 0.30
  detailedPriceCents    Int? // total cost ÷ (1 − margin)
  baseRecommendedCents  Int           @default(0) // MAX(floor, detailed)
  valueAdjustmentCents  Int           @default(0)
  finalRecommendedCents Int           @default(0)
  fiftyCheckCents       Int
  finalPriceCents       Int? // final selling price (manual or recommended)
  manualPrice           Boolean       @default(false)
  depositPct            Float         @default(50)
  depositCents          Int           @default(0)
  balanceCents          Int           @default(0)
  grossProfitCents      Int           @default(0)
  grossMarginPct        Float?
  netProfitCents        Int           @default(0)
  notes                 String?
  archivedAt            DateTime?
  createdById           String?
  createdBy             AdminUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([archivedAt, updatedAt])
  @@index([productId])
}

/// Sitewide announcement/promotion bar shown above the main navigation.
/// The first enabled announcement inside its schedule is shown.
model Announcement {
  id              String    @id @default(cuid())
  name            String // internal name, e.g. "Fall Sale 2026"
  enabled         Boolean   @default(false)
  message         String
  secondaryText   String?
  linkText        String?
  linkUrl         String?
  backgroundColor String    @default("#1f1e1c")
  textColor       String    @default("#f7f3ec")
  startsAt        DateTime?
  endsAt          DateTime?
  showEndDate     Boolean   @default(true)
  dismissible     Boolean   @default(true)
  showOnDesktop   Boolean   @default(true)
  showOnMobile    Boolean   @default(true)
  /// Bumped when the visible wording or link changes, so visitors who
  /// dismissed the previous wording see the new promotion.
  revision        Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, startsAt, endsAt])
}

/// One-time default content already applied by the production seed
/// (scripts/seed-production.ts), so it is never re-created after the owner
/// edits or deletes it.
model SeedMarker {
  key       String   @id
  appliedAt DateTime @default(now())
}

/* ------------------------------------------------------------ navigation */

/// A public-site menu. `key` is what the site renders in a given place
/// (MAIN = header, FOOTER / COMPANY / CUSTOMER_CARE = footer columns,
/// LEGAL = footer bottom row). Structure and items are edited in
/// Admin → Navigation; nothing about them is hardcoded.
model Menu {
  id        String     @id @default(cuid())
  key       String     @unique
  name      String
  /// Heading shown above the menu where the design has one (footer columns).
  title     String?
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

enum MenuItemType {
  INTERNAL_PAGE
  CUSTOM_INTERNAL_LINK
  EXTERNAL_LINK
  PRODUCT_CATEGORY
  PRODUCT
  LABEL
}

/// One menu entry. Page/category/product items keep their link even while
/// the target is unpublished; public rendering simply skips any item whose
/// target isn't live, and shows it again when it is.
model MenuItem {
  id           String       @id @default(cuid())
  menuId       String
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       MenuItem?    @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[]   @relation("MenuItemChildren")
  type         MenuItemType
  /// Blank = use the target's name (page nav label/title, category, product).
  label        String       @default("")
  url          String?
  pageId       String?
  page         Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  enabled      Boolean      @default(true)
  openInNewTab Boolean      @default(false)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([menuId, parentId, displayOrder])
}

/* ------------------------------------------------------------ sales */

/// Sequential customer-facing numbers (WMQ-1001, WMI-1001, WMO-1001).
model Counter {
  key   String @id
  value Int
}

/// Internal customer record (customers never need an online account).
/// Linked by exact email match only; admins decide anything fuzzier.
model Customer {
  id               String    @id @default(cuid())
  name             String
  email            String
  phone            String?
  zipCode          String?
  billingAddress   String?
  deliveryAddress  String?
  stripeCustomerId String?   @unique
  lastActivityAt   DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  quotes     QuoteRequest[]
  invoices   Invoice[]
  payments   Payment[]
  orders     Order[]
  activities CustomerActivity[]
  notes      InternalNote[]
  emails     EmailLog[]

  @@index([email])
  @@index([name])
  @@index([lastActivityAt])
}

/// Customer timeline: quote requested/sent/viewed/accepted, invoices,
/// payments, production milestones, logged phone calls.
model CustomerActivity {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  message    String
  quoteId    String?
  quote      QuoteRequest? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoiceId  String?
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorId    String?
  createdAt  DateTime      @default(now())

  @@index([customerId, createdAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  OPEN
  PARTIALLY_PAID
  PAID
  PAST_DUE
  VOID
  CANCELED
}

enum InvoiceKind {
  DEPOSIT
  BALANCE
  FULL
  CUSTOM
}

/// Wild Mountain invoice. Works entirely offline (manual payments); when
/// Stripe invoicing is enabled it is mirrored to a Stripe Invoice for
/// hosted payment, and Stripe webhooks update it.
model Invoice {
  id                     String         @id @default(cuid())
  /// Customer-facing number, e.g. WMI-1001.
  number                 String         @unique
  kind                   InvoiceKind    @default(FULL)
  status                 InvoiceStatus  @default(DRAFT)
  customerId             String?
  customer               Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteId                String?
  quote                  QuoteRequest?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  revisionId             String?
  revision               QuoteRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  orderId                String?
  order                  Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName           String
  customerEmail          String
  subtotalCents          Int            @default(0)
  discountCents          Int            @default(0)
  deliveryCents          Int            @default(0)
  otherChargesCents      Int            @default(0)
  taxCents               Int            @default(0)
  totalCents             Int            @default(0)
  /// Sum of successful payments minus refunds (recomputed, never typed in).
  amountPaidCents        Int            @default(0)
  dueDate                DateTime?
  customerNotes          String?
  /// Unguessable token for /invoice/[token] (offline invoices, print view).
  publicToken            String?        @unique
  stripeInvoiceId        String?        @unique
  stripeHostedInvoiceUrl String?
  stripeInvoicePdfUrl    String?
  stripeStatus           String?
  /// Stripe Checkout (immediate deposit payment). The latest session only;
  /// a new one replaces it when the previous expires. Card details are
  /// entered on Stripe's page and never saved for reuse.
  stripeCheckoutSessionId String?
  stripeCheckoutUrl       String?
  stripeCheckoutExpiresAt DateTime?
  /// open | complete | expired | processing | failed (mirrors Stripe)
  stripeCheckoutStatus    String?
  /// Sessions created so far; part of the Stripe idempotency key, so
  /// simultaneous clicks share one session instead of creating two.
  checkoutAttempts        Int            @default(0)
  sentAt                 DateTime?
  paidAt                 DateTime?
  voidedAt               DateTime?
  voidedById             String?
  voidReason             String?
  createdById            String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  lineItems     InvoiceLineItem[]
  payments      Payment[]
  internalNotes InternalNote[]
  statusEvents  StatusEvent[]
  activities    CustomerActivity[]
  emails        EmailLog[]

  @@index([status, dueDate])
  @@index([customerId])
  @@index([quoteId])
  @@index([orderId])
  @@index([stripeCheckoutSessionId])
}

model InvoiceLineItem {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int
  kind           LineItemKind @default(CUSTOM)
  description    String
  notes          String?
  quantity       Int          @default(1)
  unitPriceCents Int
  lineTotalCents Int
  taxable        Boolean      @default(true)

  @@index([invoiceId, position])
}

enum PaymentMethod {
  STRIPE
  CASH
  CHECK
  BANK_TRANSFER
  OTHER
}

enum PaymentSource {
  STRIPE
  MANUAL
}

enum PaymentRecordStatus {
  SUCCEEDED
  PENDING
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

/// Money received. Stripe payments come only from verified webhooks; manual
/// (cash/check/bank) payments are recorded by an admin. Payments are never
/// deleted — a mistaken manual entry is VOIDED with a reason. No card data
/// is ever stored.
model Payment {
  id                    String              @id @default(cuid())
  invoiceId             String?
  invoice               Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  orderId               String?
  order                 Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId            String?
  customer              Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amountCents           Int
  refundedCents         Int                 @default(0)
  method                PaymentMethod
  source                PaymentSource
  status                PaymentRecordStatus @default(SUCCEEDED)
  stripePaymentIntentId String?             @unique
  stripeChargeId        String?
  stripeInvoiceId       String?
  stripeCheckoutSessionId String?
  reference             String?
  notes                 String?
  receivedAt            DateTime
  recordedById          String?
  voidedAt              DateTime?
  voidedById            String?
  voidReason            String?
  createdAt             DateTime            @default(now())

  @@index([invoiceId])
  @@index([orderId])
  @@index([customerId])
  @@index([receivedAt])
}

/// Stripe webhook events already processed (idempotency).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Editable email content (Admin → Settings → Email templates). Body is
/// Markdown with {{placeholders}}; the branded layout is added when sent.
model EmailTemplate {
  key         String   @id
  name        String
  subject     String
  heading     String
  body        String
  buttonLabel String?
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// Every transactional email: what was sent to whom, and whether it
/// failed (so it can be retried). Records are saved before sending, so a
/// provider outage never loses the quote/invoice it relates to.
model EmailLog {
  id          String        @id @default(cuid())
  template    String
  to          String
  subject     String
  html        String
  text        String
  status      EmailStatus   @default(PENDING)
  error       String?
  attempts    Int           @default(0)
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quoteId     String?
  quote       QuoteRequest? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sentAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@index([quoteId])
  @@index([invoiceId])
  @@index([orderId])
}

/// Drawings, photos and documents attached to a quote or order from the
/// media library. Internal unless customerVisible is set.
model SalesAttachment {
  id              String        @id @default(cuid())
  mediaId         String
  media           Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  quoteId         String?
  quote           QuoteRequest? @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label           String?
  customerVisible Boolean       @default(false)
  createdById     String?
  createdAt       DateTime      @default(now())

  @@index([quoteId])
  @@index([orderId])
}
